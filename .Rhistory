library(here)
library(tidyverse)
library(mdsr)
here <- here::here()
dpath <- "data"
students <- read_csv("https://pos.it/r4ds-students-csv")
View(students)
students |>
janitor::clean_names()
View(students)
billboard
billboard <- billboard
View(billboard)
billboard |>
pivot_longer(
cols = starts_with("wk"),
names_to = "week",
values_to = "rank",
values_drop_na = TRUE
)
who2 <- who2
View(who2)
students <- read_csv("https://pos.it/r4ds-students-csv")
View(students)
billboard <- billboard
View(billboard)
?pivot_longer
View(billboard)
billboard |>
pivot_longer(
cols = starts_with("wk"),
names_to = "week",
values_to = "rank",
values_drop_na = TRUE
)
who2 <- who2
View(who2)
View(who2)
View(billboard)
View(who2)
who2 |>
pivot_longer(
cols = !(country:year),
names_to = c("diagnosis", "gender", "age"),
names_sep = "_",
values_to = "count"
)
cms_patient_experience
cms_patient_experience |>
distinct(measure_cd, measure_title)
cms_patient_experience |>
pivot_wider(
id_cols = starts_with("org"),
names_from = measure_cd,
values_from = prf_rate
)
View(cms_patient_experience)
cms_patient_experience <-cms_patient_experience
# loaded packages
library(here)
library(tidyverse)
library(ggplot2)
library(mdsr)
library(mosaicData)
library(fec16)
library(nycflights13)
here <- here::here()
dpath <- "data"
flights_joined <- flights |>
inner_join(airlines, by= c("carrier"="carrier"))
glimpse(flights_joined)
View(flights_joined)
flights_joined |>
select(carrier, name, flight, origin, dest) |>
head(3)
flights_joined |>
left_join(weather)
left_joined<- flights_joined |>
left_join(weather)
View(left_joined)
flights_joined |>
left_join(planes, by="tailnum")
left_joined <- left_joined |>
left_join(planes, by="tailnum")
View(left_joined)
top_dest <- flights |>
count(dest, sort=TRUE) |>
head(10)
View(top_dest)
flights_joined |>
semi_join(top_dest)
flights |>
anti_join(planes, by = "tailnum") |>
count(tailnum, sort = TRUE)
anti_join <- flights |>
anti_join(planes, by = "tailnum") |>
count(tailnum, sort = TRUE)
View(anti_join)
View(left_joined)
View(planes)
planes <- planes
View(anti_join)
