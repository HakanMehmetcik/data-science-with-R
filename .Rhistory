install.packages("SetMethods")
library(SetMethods)
# Confirm it's updated
packageVersion("SetMethods")
ls("package:SetMethods")  # List all functions in SetMethods
# Re-create clean df: no row names, no non-numeric columns
df_clean <- df[, c("mudahale", "demokrasi", "darbe", "ekonomi", "iletisim", "basari")]
row.names(df_clean) <- NULL  # Remove row names
# Rebuild truth table
tt_clean <- truthTable(df_clean, outcome = "basari", incl.cut = 0.75, show.cases = FALSE, complete = TRUE)
# Double-check: all numeric
str(tt_clean$tt)
# Now attempt minimization
solution_pars <- minimize(tt_clean, include = "?", details = TRUE, sol = "parsimonious")
print(solution_pars)
# Double-check: all numeric
str(tt_clean$tt)
# Keep only conditions and the outcome
tt_min <- tt_clean$tt[, c("mudahale", "demokrasi", "darbe", "ekonomi", "iletisim", "OUT")]
# Convert OUT: replace "?" with NA or numeric (if needed)
tt_min$OUT[tt_min$OUT == "?"] <- NA
tt_min$OUT <- as.numeric(tt_min$OUT)
tt_clean_fixed <- truthTable(tt_min, outcome = "OUT", complete = TRUE)
tt_min$OUT[is.na(tt_min$OUT)] <- 0
tt_clean_fixed <- truthTable(tt_min, outcome = "OUT", complete = TRUE)
solution_pars <- minimize(tt_clean_fixed, include = "?", details = TRUE, sol = "parsimonious")
solution_inter <- minimize(tt_clean_fixed, include = "?", details = TRUE, sol = "intermediate")
tt_min <- tt_min[!is.na(tt_min$OUT), ]
tt_clean_fixed <- truthTable(tt_min, outcome = "OUT", complete = TRUE)
solution_pars <- minimize(tt_clean_fixed, include = "?", details = TRUE, sol = "parsimonious")
# Keep relevant columns
tt_min <- tt_clean$tt[, c("mudahale", "demokrasi", "darbe", "ekonomi", "iletisim", "OUT")]
# Replace "?" with 0
tt_min$OUT[tt_min$OUT == "?"] <- 0
tt_min$OUT <- as.numeric(tt_min$OUT)
# Check
table(tt_min$OUT)
# Rebuild the truth table (important!)
tt_clean_fixed <- truthTable(tt_min, outcome = "OUT", complete = TRUE)
# Now, run minimization
solution_pars <- minimize(tt_clean_fixed, include = "?", details = TRUE, sol = "parsimonious")
solution_inter <- minimize(tt_clean_fixed, include = "?", details = TRUE, sol = "intermediate")
print(solution_inter)
# Ensure only numeric conditions + outcome
df_clean <- df[, c("mudahale", "demokrasi", "darbe", "ekonomi", "iletisim", "basari")]
# Make sure outcome is numeric
df_clean$basari <- as.numeric(as.character(df_clean$basari))
# Perform minimization directly (NO truthTable step)
solution <- minimize(df_clean, outcome = "basari", incl.cut = 0.75, include = "?", details = TRUE)
print(solution)
pof(df_clean, outcome = "basari")
QCAradar(solution)
# Perform necessity analysis for all conditions
necessity_results <- pof(df_clean, outcome = "basari", relation = "necessity")
# Perform necessity analysis for all conditions
necessity_results <- pof(data = df_clean, outcome = "basari", relation = "necessity")
print(necessity_results)
