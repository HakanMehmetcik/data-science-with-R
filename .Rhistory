library(tidyverse)
library(here)
dpath <- "~/Desktop/mac_projects 2/data-science-with-R/course-materials/week8_exercises"
#| warning: false
#| error: false
simd2020 <- read_csv(here(dpath, "simd2020.csv"), na="*")
View(simd2020)
view(simd2020)
names(simd2020)
class(simd2020)
spec(simd2020)
head(simd2020$Council_area)
simd2020 |>
count(Council_area)
simd2020 |>
filter(!is.na(Attendance))
simd1 <- simd2020 |>
select(Council_area)
View(simd1)
simd2 <- simd2020 |>
select(Council_area, Total_population)
View(simd2)
simd3 <- simd2020 |>
select(Council_area:Income_rate)
View(simd3)
simd4 <- simd2020 |>
select(Intermediate_Zone:Income_rate) |>
filter(Council_area=="Glasgow City")
View(simd4)
simd5 <- simd2020 |>
select(Intermediate_Zone:Income_rate) |>
