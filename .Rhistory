# Create a data frame with a vector of names, numeric ages, and a list of scores with corresponding labels
df <- data.frame(
Name = c("Alice", "Bob", "Charlie"),
Age = c(25, 30, 22),
Scores = I(list(
list(score = c(85, 90), label = c("AA", "BB")),
list(score = c(78, 88), label = c("BB", "CC")),
list(score = c(92, 95), label = c("AA", "AA"))
))
)
View(df)
